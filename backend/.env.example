# Server
PORT=5000

# MongoDB (Atlas or self-hosted connection string)
MONGO_URI=

# JWT - used to sign the admin login token
# (not yet required on non-login routes; enforcement will be added in a later phase)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS - allowed origins for the frontend
CORS_ORIGIN_DEV=http://localhost:3000
CORS_ORIGIN_PROD=

# SMTP (Nodemailer) - used to send the "forgot password" OTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aarambh Adornments <no-reply@example.com>

# Groq AI (OpenAI-compatible) - powers the "Ask Aarmbh AI" assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
